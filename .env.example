# ImpactPilot v2 environment variables (copy to .env and fill in)

# Backend
IMPACTPILOT_DB_URL=sqlite:///./data/impactpilot.db
IMPACTPILOT_CONFIG_DIR=./config
IMPACTPILOT_ACTING_AS=local-user

# Platform LLM. Set these on the server. Users do not enter them; Settings can override per browser.
# Leave blank for the manual path with no model.
IMPACTPILOT_LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Evidence sources. Sources without their key show as "needs key" and are skipped.
# Optional. Semantic Scholar's public rate limit is low; a key keeps that search from being skipped.
SEMANTIC_SCHOLAR_API_KEY=
# Required for CORE (grey literature: reports, theses). Free at https://core.ac.uk/services/api
CORE_API_KEY=
# Optional. Raises the openFDA daily limit. Free at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
# Optional web white-paper search, limited to config/web_sources.yaml. Set ONE key.
# Idea titles are sent to this provider; confirm that is allowed before enabling.
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Regulatory guidance index (FDA, EMA, ICH). Refreshed in the background when older than 7 days.
# Set to 0 on offline servers and run `python -m impactpilot.jobs.refresh_guidance` manually.
IMPACTPILOT_GUIDANCE_AUTOREFRESH=1

# Frontend (Vite)
VITE_API_URL=http://localhost:5001
